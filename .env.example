# ─── Azure / Microsoft Foundry ───────────────────────────────────────────────
PROJECT_ENDPOINT=https://<your-foundry-project>.cognitiveservices.azure.com/
MODEL_DEPLOYMENT_NAME=gpt-4.1

# ───  Server Connection ────────────────────────────────────────────────
UD_HOST=hostaddress             #UD server hostname or IP
UD_PORT=ud_port            # Default  UDT port
UD_USERNAME=your_ud_user
UD_PASSWORD=your_ud_pass
UD_ACCOUNT=your_ud_account  # Path to UD account

# ─── UniBasic Catalog Names ───────────────────────────────────────────────────
# These must match the cataloged program names in your UD account
UB_GET_ORDER=GET.ORDER.DETAILS
UB_GET_CUSTOMER=GET.CUSTOMER.INFO
UB_CHECK_INVENTORY=CHECK.INVENTORY
UB_PROCESS_ORDER=PROCESS.ORDER
UB_UPDATE_INVENTORY=UPDATE.INVENTORY
